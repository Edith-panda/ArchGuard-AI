# Gemini
GEMINI_API_KEY=

# GitHub MCP integration (use a dedicated demo repository/token with minimum permissions)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_BASE_BRANCH=main

# Safety gate: keep false by default. Set true only after a human has approved
# a remediation proposal and only for a repository you intend ArchGuard to write to.
ARCHGUARD_GITHUB_WRITE_ENABLED=false
